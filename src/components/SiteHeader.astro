---
import { BASE_PATH } from "$consts";
import { getCollection } from "astro:content";
import { SECTION_URL, extractHeadings } from "../utils";
import CommandPalette from "./CommandPalette";
import type { PaletteItem } from "./CommandPalette";

const SECTION_LABEL: Record<string, string> = {
  blog: "Blog",
  notes: "Notes",
};

const urlPath = Astro.url.pathname;
const isActive = (segment: string) => {
  const prefix = `${BASE_PATH}/${segment}`;
  return urlPath === prefix || urlPath.startsWith(prefix + "/");
};
const allPosts = await getCollection("blog");

const pageItems: PaletteItem[] = [
  { label: "Blog",  href: `${BASE_PATH}/blog`,  group: "page" },
  { label: "Notes", href: `${BASE_PATH}/notes`, group: "page" },
];

const postItems: PaletteItem[] = allPosts.map((p) => {
  const href = `${BASE_PATH}/${SECTION_URL[p.data.section] ?? p.data.section}/${p.data.slug}/`;
  return {
    label: p.data.title,
    href,
    group: "post",
    badge: SECTION_LABEL[p.data.section] ?? p.data.section,
    keywords: `${p.data.title} ${href}`,
  };
});

const headingItems: PaletteItem[] = allPosts.flatMap((p) => {
  const href = `${BASE_PATH}/${SECTION_URL[p.data.section] ?? p.data.section}/${p.data.slug}/`;
  return extractHeadings(p.id, p.data.title, href).map((h) => ({
    label: h.text,
    href: `${href}#${h.slug}`,
    group: "heading" as const,
    badge: p.data.title,
    indent: (h.level - 2) * 0.9,
    postId: p.id,
  }));
});

const currentPostId = allPosts.find((p) => {
  const href = `${BASE_PATH}/${SECTION_URL[p.data.section] ?? p.data.section}/${p.data.slug}/`;
  return urlPath === href || urlPath === href.replace(/\/$/, "");
})?.id;

const rssUrl = new URL(`${BASE_PATH}/rss.xml`, Astro.site).href;

const commandItems: PaletteItem[] = [
  { label: "Copy RSS URL", href: `clipboard:${rssUrl}`, group: "command" },
  ...(currentPostId ? allPosts.filter(p => p.id === currentPostId).map(p => ({
    label: "View Raw",
    href: `${BASE_PATH}/${SECTION_URL[p.data.section] ?? p.data.section}/${p.data.slug}/raw.txt`,
    group: "command" as const,
  })) : []),
];

const items: PaletteItem[] = [...pageItems, ...postItems, ...headingItems, ...commandItems];
---

<script>
  const setHeaderHeight = () => {
    const h = document.querySelector("header")?.getBoundingClientRect().height ?? 0;
    document.documentElement.style.setProperty("--header-h", `${h}px`);
  };
  setHeaderHeight();
  window.addEventListener("resize", setHeaderHeight);

  document.getElementById("rss-btn")?.addEventListener("click", (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    navigator.clipboard.writeText(btn.dataset.url ?? "");
    btn.dataset.copied = "";
    btn.addEventListener("animationend", () => delete btn.dataset.copied, { once: true });
  });
</script>

<header>
  <nav>
    <a href={`${BASE_PATH}/blog`} class={isActive("blog") ? "active" : ""}>Blog</a>
    <a href={`${BASE_PATH}/notes`} class={isActive("notes") ? "active" : ""}>Notes</a>
    <button id="rss-btn" class="cp-trigger" data-url={rssUrl} aria-label="Copy RSS URL" title="Copy RSS URL">
      <svg class="rss-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 11a9 9 0 0 1 9 9" />
        <path d="M4 4a16 16 0 0 1 16 16" />
        <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />
      </svg>
      <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </button>
    <CommandPalette items={items} currentPostId={currentPostId} client:load />
  </nav>
  <hr />
</header>

<style>
  header {
    position: sticky;
    top: 0;
    background: var(--main-bg-color);
    z-index: 10;
    margin: 0 -1.5rem;
    padding: env(safe-area-inset-top) 1.5rem 0;
  }
  nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.5rem;
    padding: 0.5rem 0;
    line-height: 1;
  }
  nav a {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--main-color);
    opacity: 0.45;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  nav a:hover { opacity: 1; color: var(--gold); }
  nav a.active { opacity: 1; color: var(--gold); }
  hr {
    border: none;
    border-top: 1px solid currentColor;
    opacity: 0.15;
    margin: 0;
  }

  @keyframes rss-copied { to { opacity: 0.45; } }
  #rss-btn .rss-icon { display: block; }
  #rss-btn .check-icon { display: none; }
  #rss-btn[data-copied] { animation: rss-copied 1.5s forwards; color: var(--gold); opacity: 1; }
  #rss-btn[data-copied] .rss-icon { display: none; }
  #rss-btn[data-copied] .check-icon { display: block; }
</style>

<style is:global>
  .cp-trigger {
    display: flex;
    align-items: center;
    line-height: 1;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin: 0;
    color: var(--main-color);
    opacity: 0.45;
    transition: opacity 0.15s ease, color 0.15s ease;
    vertical-align: middle;
  }
  .cp-trigger:hover { opacity: 1; color: var(--gold); }
  .cp-trigger svg { display: block; }

  .cp-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    backdrop-filter: blur(2px);
  }

  .cp-modal {
    position: relative;
    background: var(--main-bg-color);
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 10px;
    width: min(520px, 90vw);
    max-height: 60vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);
  }

  .cp-input-row {
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(128, 128, 128, 0.2);
  }
  .cp-input-row [cmdk-input] {
    border-bottom: none;
    flex: 1;
  }
  .cp-close {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 0.75rem;
    color: var(--main-color);
    opacity: 0.35;
    transition: opacity 0.15s ease;
  }
  .cp-close:hover { opacity: 0.8; }
  .cp-close svg { display: block; }

  .cp-modal [cmdk-root] {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .cp-modal [cmdk-input] {
    width: 100%;
    padding: 0.85rem 1rem;
    font-size: 1rem;
    font-family: inherit;
    color: var(--main-color);
    background: transparent;
    border: none;
    outline: none;
  }
  .cp-modal [cmdk-input]::placeholder { opacity: 0.4; }

  .cp-modal [cmdk-list] {
    overflow-y: auto;
    padding: 0.4rem 0;
    flex: 1;
    min-height: 0;
  }

  .cp-modal [cmdk-item] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1rem;
    cursor: pointer;
    gap: 1rem;
  }
  .cp-modal [cmdk-item][aria-selected="true"] {
    background: rgba(var(--gold-rgb), 0.12);
  }
  .cp-modal [cmdk-item]:hover {
    background: rgba(var(--gold-rgb), 0.08);
  }

  .cp-modal [cmdk-empty] {
    padding: 1.5rem 1rem;
    text-align: center;
    opacity: 0.4;
    font-size: 0.9rem;
  }

  .cp-modal [cmdk-group-heading] {
    padding: 0.4rem 1rem 0.15rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.35;
    color: var(--main-color);
  }

  .cp-title {
    font-size: 0.95rem;
    color: var(--main-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cp-title--page {
    font-weight: 700;
    color: var(--gold);
  }
  .cp-title--heading {
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    scroll-margin-top: calc(var(--header-h, 60px) + 8px);
  }

  .cp-badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0.7;
    flex-shrink: 0;
  }
</style>
