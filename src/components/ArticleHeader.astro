---
import { formatDate } from "../utils";
import { BASE_PATH } from "$consts";

interface Props {
  title: string;
  date: Date;
  updatedDate?: Date;
  tags?: string[];
}

let { title, date, updatedDate, tags } = Astro.props;
tags.sort();
---

<div class="article-header">
  <h1><a href={`./raw.txt`}>{title}</a></h1>
  <div class="date">
    <div> {formatDate(date)} </div>
    {updatedDate && (
      <div class="last-updated-on">
        <small> Updated on {formatDate(updatedDate)} </small>
      </div>
    )}
  </div>
  
</div>

<style>
  .article-header {
    margin-bottom: 1em;
    padding: 0 0 0 0;
    text-align: left;
    line-height: 1;
  }

  h1 {
    margin: 0 0 0em 0;
    text-align: left;
    letter-spacing: normal;
  }

  h1 a {
    color: inherit;
    text-decoration: none;
  }

  h1 a:hover {
    text-decoration: underline;
  }

  .last-updated-on {
    margin-top: 0.3em;
    font-size: 1.3rem;
  }


</style>